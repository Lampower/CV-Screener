# OpenAI API key. Used for resume prose (gpt-4o-mini), headshot generation
# (gpt-image-1), embeddings (text-embedding-3-small), and the chat agent.
OPENAI_API_KEY=sk-...

# Postgres connection string for the pgvector store started via
# `docker compose up -d`. This default matches docker-compose.yml as-is.
DATABASE_URL=postgresql+psycopg://cvscreener:cvscreener@localhost:5432/cvscreener

# S3-compatible object storage (pgsty/minio, started via `docker compose up
# -d` alongside Postgres) for generated photos + PDF resumes. These
# defaults match docker-compose.yml as-is. Console UI: http://localhost:9001
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=cvscreener
S3_SECRET_KEY=cvscreener-storage
S3_BUCKET=cv-screener
